{
  "name": "mission-english-rag",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern data/parsed",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:preprocess": "tsx scripts/preprocess.ts",
    "data:ingest": "tsx scripts/ingest.ts",
    "data:verify": "tsx scripts/verify-supabase.ts",
    "api:verify:upstage": "tsx scripts/verify-upstage.ts",
    "api:verify:openai": "tsx scripts/verify-openai.ts",
    "data:setup": "pnpm data:preprocess && pnpm data:ingest && pnpm data:verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.4.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
