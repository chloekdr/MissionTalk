# Server-only API keys. Never prefix these with NEXT_PUBLIC_.
UPSTAGE_API_KEY=replace_me
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini

# Supabase project settings. Use the service-role key only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Optional tuning
RAG_MATCH_THRESHOLD=0.35
RAG_MATCH_COUNT=5
